{
  "title": "RAG API 监控大盘",
  "uid": "rag-api-overview",
  "tags": ["rag", "fastapi"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "QPS（按接口）",
      "description": "每秒请求数，按路由拆分",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total[1m]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 延迟 P50 / P95",
      "description": "全接口请求耗时分位数",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_highr_seconds_bucket[5m])))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket[5m])))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx 错误数（5 分钟）",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{status=\"5xx\"}[5m])) or vector(0)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Agent 完整流程耗时 P50 / P95",
      "description": "未命中答案缓存的真实执行耗时（agent_ask_seconds）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(agent_ask_seconds_bucket[5m]))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(agent_ask_seconds_bucket[5m]))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token 消耗速率（按类型）",
      "description": "input / output / cache_hit（DeepSeek 前缀缓存命中部分按 1 折计费）",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (type) (rate(llm_tokens_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "累计 Token 消耗",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (type) (llm_tokens_total)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "答案级缓存命中率（累计）",
      "description": "GPTCache 模式：命中直接跳过整个 Agent 流程（后端进程启动以来累计）",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(rag_answer_cache_requests_total{result=\"hit\"}) or vector(0)) / sum(rag_answer_cache_requests_total)",
          "legendFormat": "命中率"
        }
      ]
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "LLM 响应缓存命中率（累计）",
      "description": "LangChain set_llm_cache：rerank、查询改写等重复 prompt 命中（后端进程启动以来累计）",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(rag_llm_cache_requests_total{result=\"hit\"}) or vector(0)) / sum(rag_llm_cache_requests_total)",
          "legendFormat": "命中率"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "缓存查询次数（按结果）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (result) (increase(rag_answer_cache_requests_total[5m]))",
          "legendFormat": "答案缓存-{{result}}"
        },
        {
          "expr": "sum by (result) (increase(rag_llm_cache_requests_total[5m]))",
          "legendFormat": "LLM缓存-{{result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "RAG 流水线各阶段平均耗时",
      "description": "拆解耗时瓶颈：改写查询 / 混合检索 / LLM 重排 / 生成回答",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (stage) (rate(rag_stage_seconds_sum[5m])) / sum by (stage) (rate(rag_stage_seconds_count[5m]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "知识库规模",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "kb_documents", "legendFormat": "文档数" },
        { "expr": "kb_chunks", "legendFormat": "文档块数" }
      ]
    }
  ]
}
